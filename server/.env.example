# Copy to .env and fill in. Get these from Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Server-side ONLY. The service role key bypasses RLS - never expose it to the
# browser / commit it. The Express server is the trusted layer.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Port the API listens on (the Vite dev proxy points here).
PORT=4000

# Groq API key (used for AI brand extraction / crawling). Optional model override.
GROQ_API=YOUR-GROQ-API-KEY
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Claude "brand brain" content engine (engine.js) -------------------------
# On-brand post generation runs the Claude Agent SDK inside a per-client
# workspace built from the brand documents (same engine as Claude Code). This
# is the ONLY content path — a failure is retried, then surfaced as an error;
# it is NEVER silently downgraded to Groq. Requires a key below.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY
# Model (default: claude-haiku-4-5 — cheapest, good for short brand copy). Bump
# to claude-sonnet-4-5 / claude-opus-4.1 if a client needs higher fidelity.
# If you route through a gateway, use ITS slug (e.g. claude/claude-haiku-4-5).
# ANTHROPIC_MODEL=claude-haiku-4-5
# Opt-in "Stronger rewrite" / polish model (UI button). Default stays Haiku.
# ANTHROPIC_POLISH_MODEL=claude-sonnet-4-5
# Set to 1 to auto-use polish model for long-form formats only (article/essay/newsletter):
# ENGINE_AUTO_POLISH_LONGFORM=0
# Retries before a generation errors out (no Groq fallback exists):
# ENGINE_MAX_ATTEMPTS=2
# Prompt-size budget (cost control) — see engine.js:
# ENGINE_DOC_CHAR_CAP=4000        # max chars inlined per brand file
# ENGINE_DOC_TOTAL_CAP=16000      # max chars inlined across ALL brand files
# Engine mode: lean (default — one cheap/fast call, docs inlined) or agentic
# (full Claude Code loop, higher fidelity, more tokens/latency).
# ENGINE_MODE=lean
# Agentic-mode tuning (ignored in lean mode):
# ANTHROPIC_EFFORT=medium        # low|medium|high|xhigh|max — lower = cheaper/faster
# ANTHROPIC_MAX_TURNS=8          # cap on the agent's read→decide→write loop
# OpenRouter alternative (Anthropic-compatible endpoint) - instead of the key
# above, set BOTH of these (only Anthropic first-party models supported):
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=YOUR-OPENROUTER-API-KEY
# Legacy Groq path — OFF by default and lower brand fidelity. Only set this to
# deliberately use Groq instead of Claude for content generation:
# CONTENT_ENGINE=groq
# AI idea suggestions (Research tab): with OPENROUTER_API_KEY set, a cheap
# model gets live web-search results on the topic before proposing ideas
# (falls back to Groq on any failure). Optional model override - any
# OpenRouter model id works:
# SUGGEST_MODEL=google/gemini-3-flash-preview

# OpenRouter API key (used for AI image generation in the Photo Library).
# Get one at https://openrouter.ai/keys. Optional model override - any
# OpenRouter model with image output works (default: Gemini 2.5 Flash Image).
OPENROUTER_API_KEY=YOUR-OPENROUTER-API-KEY
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Per-client AI spend (Team -> Users & access "AI spend" column) ----------
# Every AI call is tagged with the client it was made for (OpenRouter's `user`
# field) and its reported cost is written to the ai_usage table, so the column
# works with nothing extra configured - apply the migration and it fills in.
#
# OPTIONAL, and only for cross-checking against OpenRouter's own books: a
# MANAGEMENT key (openrouter.ai/settings/management-keys - NOT the inference
# key above, which gets a 403). With it set, /api/usage/spend also reports the
# account's credit balance and OpenRouter's own spend-per-client figures.
# OPENROUTER_MANAGEMENT_KEY=YOUR-OPENROUTER-MANAGEMENT-KEY

# Shared secret for external cron jobs that hit /api/cron/* (no user JWT).
# Send as: Authorization: Bearer <value>  or  x-cron-secret: <value>
CRON_SECRET=YOUR-LONG-RANDOM-SECRET

# Stream research cost knobs (defaults are already cheap):
# SUGGEST_MODEL=openai/gpt-4o-mini
# STREAM_MAX=5                 # max topics kept per client (1–5)
# STREAM_WEB_RESULTS=3         # Exa web hits per refresh (1–5; lower = cheaper)

# --- Apify (live social performance data) -----------------------------------
# Powers the Performance page. Get a token from Apify Console → Settings →
# Integrations. Without it, /api/clients/:id/social/refresh returns a 503
# explaining what's missing; cached reads still work.
APIFY_TOKEN=YOUR-APIFY-TOKEN

# Apify runs are synchronous here and capped by Apify at 300s.
# APIFY_TIMEOUT_MS=240000
# TikTok is started async and polled (clockworks overruns the 300s sync cap).
# APIFY_TIKTOK_TIMEOUT_MS=480000

# Actor slugs are overridable so a renamed//preferred actor needs no code
# change. Defaults are the common public actors; set any of these if a run
# returns 404 "actor not found", or to swap in a paid actor you prefer.
# APIFY_ACTOR_INSTAGRAM_PROFILE=apify~instagram-profile-scraper
# APIFY_ACTOR_INSTAGRAM_POSTS=apify~instagram-post-scraper
# APIFY_ACTOR_LINKEDIN_PROFILE=apimaestro~linkedin-company-detail
# APIFY_ACTOR_LINKEDIN_POSTS=apimaestro~linkedin-company-posts
# APIFY_ACTOR_X_PROFILE=clappi~x-twitter-profile-scraper
# APIFY_ACTOR_X_POSTS=scraper_one~x-profile-posts-scraper
# APIFY_ACTOR_SUBSTACK_POSTS=automation-lab~substack-scraper
# APIFY_ACTOR_TIKTOK_POSTS=clockworks~tiktok-scraper
# APIFY_ACTOR_TIKTOK_COMMENTS=clockworks~tiktok-comments-scraper
# APIFY_ACTOR_INSTAGRAM_COMMENTS=apify~instagram-comment-scraper
# APIFY_ACTOR_LINKEDIN_COMMENTS=apimaestro~linkedin-post-comments-replies-engagements-scraper-no-cookies
# APIFY_ACTOR_X_COMMENTS=scraper_one~x-post-replies-scraper
# How many comment texts to pull per post (0 = counts only). Default 12.
# APIFY_COMMENTS_PER_POST=12
